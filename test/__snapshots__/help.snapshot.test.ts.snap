exports[`--help snapshots > ci 1`] = `
"Usage: testsprite ci [options] [command]

Scaffold CI integration for TestSprite

Options:
  -h, --help                 display help for command

Commands:
  init [options] <platform>  Write a CI workflow that runs your TestSprite
                             tests (platform: github)
  doctor [options]           Check that deployment events reach this repo — the
                             precondition a deployment-gated workflow rests on
  connect [options]          Link your deploy platform (Vercel) to this repo so
                             deployment events are emitted
  help [command]             display help for command
"
`;

exports[`--help snapshots > ci init 1`] = `
"Usage: testsprite ci init [options] <platform>

Write a CI workflow that runs your TestSprite tests (platform: github)

Options:
  --project <id>       project id to run (auto-detected if you have exactly
                       one)
  --filter <substr>    only run tests whose name contains this substring
  --timeout <s>        max seconds to wait for a terminal verdict (1-3600)
                       (default: "600")
  --path <file>        output path for the workflow (default:
                       ".github/workflows/testsprite.yml")
  --force              overwrite an existing workflow (a .bak backup is kept)
                       (default: false)
  --set-secret         set the TESTSPRITE_API_KEY repo secret via gh (if
                       installed + authenticated); OVERWRITES an existing
                       secret of that name (default: false)
  --repo <owner/name>  target repo for --set-secret (gh infers from the cwd if
                       omitted)
  -h, --help           display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > init 1`] = `
