exports[`--help snapshots > project 1`] = `
"Usage: testsprite project [options] [command]

Manage TestSprite projects

Options:
  -h, --help                         display help for command

Commands:
  list [options]                     List projects visible to the API key
  
  Exit codes:
    0  success
    3  auth error
    5  validation error (e.g., bad --page-size)
   10  transport/network failure (UNAVAILABLE) — retry the command
  get <project-id>                   Get a project by id
  create [options]                   Create a new project
  update [options] <project-id>      Update project metadata
  delete [options] <project-id>      Permanently delete a project and everything under it (sub-projects,
  their tests, and backend fixtures). Requires --confirm.
  
  Exit codes:
    0  success
    3  auth error
    4  project not found (or already deleted)
    5  validation error (e.g., missing --confirm)
  credential [options] <project-id>  Set the static backend credential injected
                                     into every backend test
                                     (Bearer token / API key / Basic token /
                                     public). Free tier.
  auto-auth [options] <project-id>   Configure the recurring-token
                                     (auto-refresh login) for backend tests
                                     (Pro).
                                     A fresh token is fetched on each run and
                                     injected into every backend test.
  docs                               Manage project documents — the sources
                                     plan generation feeds on
  env                                Manage a project's environments — named
                                     URL + test-account bundles that \`test run
                                     --env <name>\` selects
  sign-in                            Inspect or change how an environment signs
                                     in to the app under test.
  help [command]                     display help for command
"
`;

exports[`--help snapshots > project create 1`] = `
"Usage: testsprite project create [options]

Create a new project

Options:
  --type <frontend|backend>    project type (required)
  --name <name>                project name (required)
  --url <url>                  target URL (public http/https or a loopback http
                               origin with an explicit port; required for
                               frontend unless --local is used; also required
                               for backend on the V3 execution path — see \`auth
                               status\` for your routing)
  --local <port>               shorthand for --url http://localhost:<port>
                               (1-65535; excludes --url; runs open a tunnel
                               automatically)
  --skip-preflight             skip the local TCP listener check before project
                               creation
  --description <text>         not supported — projects have no description
                               (test-level descriptions are set on \`test
                               create\`)
  --username <user>            optional auth username
  --password <pw>              optional auth password (use --password-file for
                               non-interactive)
  --password-file <path>       read password from file instead of inline flag
  --instruction <text>         optional FE plan-gen instruction hint
  --test-id-attributes <list>  comma-separated DOM attributes the engine should
                               prefer as locators, highest priority first (e.g.
                               data-element,data-testid). Unique values are
                               exported as page.locator('[attr="…"]').
  --idempotency-key <token>    opaque idempotency token. Defaults to a UUIDv4
                               minted per invocation.
  -h, --help                   display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > project docs upload 1`] = `
"Usage: testsprite project docs upload [options] <file>

Upload an API spec or PRD as a project source. Three steps:
mint a presigned S3 URL, stream the file bytes to it, register the
document — which starts processing + embedding. The local file is
only read; nothing is written back to disk.

Exit codes:
  0  upload registered (processing started)
  3  auth error
  4  project not found (or not accessible in this workspace)
  5  validation error (missing/empty file, bad --role)
  7  request timeout (also: backend predates the docs routes)
 10  presigned S3 PUT failed — re-run to mint a fresh URL

Options:
  --project <id>             project id the document belongs to (required)
  --role <role>              document role: api-doc (API spec, default) | prd
  --name <display-name>      display name for the document (default: file
                             basename)
  --idempotency-key <token>  opaque idempotency token. Defaults to a UUIDv4
                             minted per invocation.
  -h, --help                 display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > project env create 1`] = `
"Usage: testsprite project env create [options] <project-id>

Create an environment (--name and one of --url / --local are required).
Exit codes:
  0  success
  3  auth error
  4  project not found
  5  validation error
  6  conflict (name already exists) / precondition (OTP or SSO on a local environment)
  7  unsupported (V2 environments or OTP/SSO in BYOC)
  10 service unavailable
  11 rate limited
  13 SSO feature gated
  14 client too old

Options:
  --name <name>                  environment name, unique within the project
                                 (required)
  --url <url>                    address runs open (public http/https, or a
                                 loopback http origin with an explicit port)
  --local <port>                 shorthand for --url http://localhost:<port>
                                 (1-65535; excludes --url; frontend only)
  --skip-preflight               skip the local TCP listener check before
                                 creating
  --username <user>              test-account username the browser logs in with
  --password <pw>                test-account password (prefer --password-file)
  --password-file <path>         read the password from a file instead of the
                                 command line
  --var <KEY=VALUE>              set a custom variable (repeatable); shown in
                                 plain text by \`env get\` — not for secrets, use
                                 --username/--password (default: [])
  --sign-in <mode>               public, account, otp, or manual (aliases:
                                 none, credentials, sso)
  --otp-channel <email,sms>      OTP channels: email and/or sms; repeat or
                                 comma-separate
  --session-ttl <seconds|never>  SSO session reuse lifetime: 1–2592000 seconds
                                 or never (manual only)
  --set-default                  make this the project's default environment
                                 (default: false)
  --idempotency-key <token>      opaque idempotency token. Defaults to a UUIDv4
                                 minted per invocation.
  -h, --help                     display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > project env update 1`] = `
"Usage: testsprite project env update [options] <project-id> <name>

Change an environment's URL, credentials or name.
Exit codes:
  0  success
  3  auth error
  4  project (or environment) not found
  5  validation error
  6  conflict (name already exists) / precondition (credentials or --local on an SSO or OTP environment; see \`project sign-in set\`)

Options:
  --url <url>                new address runs open (public http/https, or a
                             loopback http origin with an explicit port)
  --local <port>             shorthand for --url http://localhost:<port>
                             (1-65535; excludes --url)
  --skip-preflight           skip the local TCP listener check before the
                             update
  --username <user>          new test-account username
  --password <pw>            new test-account password (prefer --password-file)
  --password-file <path>     read the new password from a file
  --clear-credentials        remove stored username and password; disable
                             account login
  --var <KEY=VALUE>          merge a custom variable (repeatable); shown in
                             plain text by \`env get\` — not for secrets, use
                             --username/--password (default: [])
  --rename <new-name>        rename the environment (runs keep referring to it
                             by the new name)
  --idempotency-key <token>  opaque idempotency token. Defaults to a UUIDv4
                             minted per invocation.
  -h, --help                 display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

