exports[`--help snapshots > test list 1`] = `
"Usage: testsprite test list [options]

List tests in a project

Options:
  --project <id>            project id (required unless TESTSPRITE_PROJECT_ID
                            is set)
  --env <name>              show frontend test statuses for the named project
                            environment
  --type <type>             filter by test type (frontend|backend)
  --created-from <source>   filter by where the test was authored
                            (portal|mcp|cli)
  --status <list>           filter by the status of each test case's latest
                            result (comma-separated; accepted:
                            passed|failed|blocked|cancelled|not_run; not_run =
                            never ran)
  --page-size <n>           fetch ONE page of N items (1-100) and print the
                            next token (default: follow every page; --max-items
                            caps that)
  --starting-token <token>  opaque cursor from a previous list response
  --cursor <token>          alias for --starting-token; accepted for parity
                            with \`test result --history\`
  --max-items <n>           stop after this many items across auto-paged pages
  --columns <list>          select/reorder text table columns (comma-separated
                            keys)
  --no-header               suppress the text table header row
  -h, --help                display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > test plan 1`] = `
"Usage: testsprite test plan [options] [command]

Generate + accept AI test plans (V3), and manage FE plan-steps

Options:
  -h, --help               display help for command

Commands:
  put [options] <test-id>  Replace an FE test's planSteps[] (BE tests return
                           400 → use 'test code put')
  generate [options]       Generate AI test-case proposals for review
  accept [options]         Turn staged proposals into test cases (free)
  help [command]           display help for command
"
`;

exports[`--help snapshots > test plan accept 1`] = `
"Usage: testsprite test plan accept [options]

Convert staged proposals into real test cases (free) — all of them, or a subset
with --only

Options:
  --project <id>             project id (or set TESTSPRITE_PROJECT_ID)
  --only <ids...>            accept only these proposal ids from the \`test plan
                             generate\` table (space- or comma-separated); the
                             rest are discarded. Any id matching no staged
                             proposal is a validation error.
  --idempotency-key <token>  idempotency token (1-256 ASCII chars; default:
                             random UUID per invocation, pin one for safe
                             retries)
  -h, --help                 display help for command

Accepting adds no charge. API test code is generated when the tests first run. The staging
area is cleared either way (the output says how many proposals were discarded).
Nothing staged: exit 6, pointing at \`test plan generate\`.


Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > test plan generate 1`] = `
"Usage: testsprite test plan generate [options]

Generate AI test-case proposals for a project: runs only the missing pipeline
stages and stages the results server-side for review (nothing is written
locally)

Options:
  --project <id>             project id (or set TESTSPRITE_PROJECT_ID)
  --timeout <seconds>        total wait budget in seconds (1-3600, default
                             1800; exploration of a fresh frontend project
                             takes minutes)
  --idempotency-key <token>  idempotency token (1-256 ASCII chars; default:
                             random UUID per invocation, pin one for safe
                             retries)
  -h, --help                 display help for command

Stages that run: exploration (frontend), strategy, proposals. On interrupt (exit 130/143/129)
or timeout (exit 7) the running stage finishes on its own; re-run the same command to continue.
A completed stage is never charged again. Workspace credits are spent per stage that runs;
the result line reports what THIS run charged. \`testsprite usage\` shows your balance.

Next: review the printed table, then \`testsprite test plan accept\`.

Exit codes:
  0  proposals staged for review
  1  a pipeline stage failed server-side (re-run to retry it)
  3  authentication error
  5  validation error
  7  timeout (re-run to continue)
 11  rate limited
 12  insufficient credits


Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > test rerun 1`] = `
"Usage: testsprite test rerun [options] [test-ids...]

[deprecated] Use \`testsprite test run\` instead; removed in 0.17.0. Re-execute a test case (or several) as a replay — FE replays the saved script, BE re-runs the dependency closure. Billed like a fresh run on V3 workspaces (0.5 credits per FE case, 0.2 per BE case). Legacy V2 accounts: reruns are free.

Exit codes:
  0  passed (or queued without --wait)
  1  failed / blocked / cancelled
  3  auth error
  4  test not found (single), or batch: nothing queued — every id had no replayable run
  5  validation error, or --all resolved zero tests (pass --allow-empty to exit 0)
  6  conflict (already running — see nextAction for the active runId)
  7  timeout or deferred — resume with: testsprite test wait <run-id>, or stop it with: testsprite test cancel <run-id>
 11  rate limited — honor Retry-After

On failure/blocked/cancelled, run: testsprite test artifact get <run-id>

Ctrl-C during --wait detaches only (the run keeps executing and billing);
stop it for real with: testsprite test cancel <run-id>

Options:
  --all                       rerun all tests in the resolved project (requires
                              --project) (default: false)
  --project <id>              project id (required with --all)
  --skip-terminal             with --all: skip tests already in a terminal
                              status (passed|failed|blocked|cancelled)
                              (default: false)
  --status <list>             with --all: only dispatch tests whose status
                              matches one of these values (comma-separated;
                              accepted:
                              draft|ready|queued|running|passed|failed|blocked|cancelled|unknown)
  --filter <substr>           with --all: only rerun tests whose name contains
                              this substring (case-insensitive)
  --wait                      block until terminal status or --timeout elapses
                              (default: false)
  --no-wait                   detach without opening an automatic environment
                              tunnel
  --skip-preflight            skip the loopback port probe before opening a
                              tunnel
  --timeout <s>               with --wait, max seconds to wait (1–3600, default
                              600)
  --no-auto-heal              replay the saved script verbatim instead of
                              letting the agent repair it (default: auto-heal
                              is ON for FE reruns; a heal replaces the stored
                              code). Ignored for backend reruns.
  --skip-dependencies         BE only: rerun only the named test without
                              expanding the producer/teardown closure (default:
                              false)
  --env <name>                replay against the named project environment —
                              its credentials, auto-auth and OTP settings (see
                              \`testsprite project env list <project-id>\`);
                              loopback URLs open a tunnel. Default: the
                              project's default environment. Applies to every
                              test of a batch.
  --max-concurrency <n>       with a tunnel, max runs in flight (1-10, default
                              5); otherwise with --wait, max polls (1-100,
                              default 50)
  --idempotency-key <key>     opaque key for safe retries (1–256 chars)
  --report <format>           with batch --wait: write a JUnit XML sidecar
                              report after polling (accepted: junit)
  --report-file <path>        output path for --report (atomic write)
  --report-suite-name <name>  optional JUnit <testsuite name=...> override
                              (default: testsprite:<projectId>)
  --gh-output                 with batch --wait: emit GitHub annotations
                              (::error:: failed/timed-out, ::warning:: never
                              dispatched) and a job-summary table when
                              $GITHUB_STEP_SUMMARY is set; auto-enabled when
                              GITHUB_ACTIONS=true
  --summary-file <path>       with batch --wait: also write summary JSON
                              {total, passed, failed, skipped, timedOut,
                              runs[]} to this file
  --allow-empty               with --all: exit 0 when no tests match (default:
                              exit 5, so an empty rerun is not a CI
                              false-green)
  -h, --help                  display help for command

Notes:
  • A rerun replays a SAVED run/script, so one must exist; \`test run\` starts fresh.
    A BE rerun also expands the dependency closure.
  • Batch --wait: rate-deferred tests appear in \`deferred[]\` / \`summary.deferred\` and force a
    non-zero exit; they are not counted in \`summary.total\`.

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > test result 1`] = `
"Usage: testsprite test result [options] <test-id>

Get the latest result for a test (default) or list prior runs (--history).
"with --history" flags are ignored without --history (--env is rejected, exit
5).

--output json: a single CliLatestResult, or with --history
{ runs: RunHistoryItem[], nextCursor: string|null, meta: RunHistoryMeta }.

Per-run detail: testsprite test wait <run-id>
Failure bundle:  testsprite test artifact get <run-id>

Options:
  --include-analysis  attach the inline \`analysis\` block (rootCauseHypothesis,
                      recommendedFixTarget, failureKind, snapshotId) (default:
                      false)
  --history           list prior runs for this test instead of showing the
                      latest result
  --source <src>      with --history: filter by trigger source
                      (cli|portal|mcp|schedule|github_action)
  --since <dur>       with --history: lower bound on createdAt — 24h, 7d, or
                      ISO timestamp (client-side translated)
  --page-size <n>     with --history: number of runs per page (1–100, default
                      20)
  --cursor <token>    with --history: opaque cursor from a prior page
  --rerun             with --history: show only reruns
  --no-rerun          with --history: show only fresh (non-rerun) runs
  --env <name>        with --history: only runs whose credentials came from
                      this project environment
  --columns <list>    with --history: select/reorder text table columns
  --no-header         with --history: suppress the text table header row
  -h, --help          display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > test run 1`] = `
"Usage: testsprite test run [options] [test-id...]

Trigger a run of one or more test cases. Saved loopback environments open a tunnel automatically and wait for a verdict.
Pass several <test-id>s, or use --all --project <id> [--filter <substr>], for a batch run (ids are grouped per project and sent 50 per request). Loopback environments share one tunnel.

Exit codes:
  0  passed (or queued without --wait)
  1  failed / blocked / cancelled
  3  auth error
  4  test not found
  5  validation error (e.g., bad URL, or positional + --all both set)
  6  conflict (already running — see nextAction for the active runId)
  7  timeout — resume with: testsprite test wait <run-id>, or stop it with: testsprite test cancel <run-id>
 10  transport/network failure (UNAVAILABLE) — retry the command
 11  rate limited — honor Retry-After
 12  insufficient credits (non-retriable; top up)
 13  feature gated / workspace paused

On failure/blocked/cancelled, run: testsprite test artifact get <run-id>

Ctrl-C during an ordinary --wait detaches; an owned tunnel cancels unfinished runs by default.
Stop a detached run with: testsprite test cancel <run-id>
Dev servers can take a minute per page through a tunnel; prefer a built server (npm run build, then start).

Options:
  --target-url <url>          frontend tests only: run against this URL, using
                              the environment for its origin (else a temporary
                              one deleted after the run); with --env, that
                              environment's settings; loopback URLs open a
                              tunnel
  --skip-preflight            skip the pre-charge reachability probe of the
                              target URL (it runs from this machine, not the
                              cloud, so it can be wrong, e.g. behind an IP
                              allowlist) (default: false)
  --local <port>              run against an app on THIS machine through a
                              TestSprite tunnel (the runner opens
                              http://localhost:<port>). Implies --wait.
                              Frontend tests only; several ids or --all share
                              one tunnel (5 concurrent, max 10). A dead port is
                              refused before anything is billed.
  --local-host <host>         with --local, loopback address in the target URL:
                              localhost, 127.0.0.1, ::1 (default: saved
                              matching host, else localhost). Use localhost if
                              your app only answers on that name, ::1 for
                              IPv6-only.
  --tunnel-client <id>        for a loopback environment or --local, attach to
                              a tunnel already running under \`testsprite tunnel
                              start\` (use the id it prints) instead of opening
                              one; that process keeps the tunnel open
                              afterwards.
  --no-cancel-on-interrupt    with a tunnel, do not auto-cancel runs when an
                              owned tunnel closes or a borrowed tunnel's owner
                              disappears
  --env <name>                run against the named project environment — its
                              credentials, auto-auth and OTP settings (see
                              \`testsprite project env list <project-id>\`); a
                              loopback one opens a tunnel. Default: the
                              project's default environment. Also applies with
                              --all.
  --wait                      poll until terminal status or --timeout elapses
                              (default: false)
  --no-wait                   detach without opening an automatic environment
                              tunnel
  --timeout <s>               with --wait, max seconds per run (1–3600; default
                              600, or 1200 through a tunnel)
  --idempotency-key <key>     opaque key for safe retries (1–256 chars); local
                              batches append each test id
  --all                       run all tests in the project in wave order (uses
                              --project or TESTSPRITE_PROJECT_ID); excludes
                              <test-id> (default: false)
  --project <id>              project id for --all (overrides
                              TESTSPRITE_PROJECT_ID)
  --filter <substr>           with --all: only run tests whose name contains
                              this substring (case-insensitive)
  --status <list>             with --all: only run tests whose latest status
                              matches one of these values (comma-separated;
                              accepted:
                              passed|failed|blocked|cancelled|not_run; not_run
                              = never ran); --env only picks where to run
  --max-concurrency <n>       with a tunnel, max runs in flight through one
                              tunnel (1-10, default 5); with --all or several
                              ids and --wait without a tunnel, max polls
                              (1-100, default 50)
  --report <format>           with a --wait batch (--all or several ids): write
                              a JUnit XML sidecar report after polling
                              (accepted: junit)
  --report-file <path>        output path for --report (atomic write)
  --report-suite-name <name>  optional JUnit <testsuite name=...> override
                              (default: testsprite:<projectId>)
  --gh-output                 with --wait: emit GitHub annotations (::error::
                              failed/timed-out, ::warning:: never dispatched)
                              and a job-summary table when $GITHUB_STEP_SUMMARY
                              is set; auto-enabled when GITHUB_ACTIONS=true
  --summary-file <path>       with --wait: also write summary JSON {total,
                              passed, failed, skipped, timedOut, runs[]} to
                              this file
  --allow-empty               with --all: exit 0 when ZERO test cases are
                              dispatched (default: exit 5, so an empty run is
                              not a CI false-green)
  --no-auto-heal              request strict replay of stored test code instead
                              of letting the agent heal drifted generated code
                              (the server decides the default); use for
                              regression gates and bisects. Code you wrote
                              yourself is never re-authored. The server rejects
                              the flag where replay is unavailable and may
                              refuse a test with no replayable code; the CLI
                              prints an [advisory] if the opt-out did not take.
  --skip-dependencies         Backend test cases only: run without the test
                              cases they depend on (default: false)
  -h, --help                  display help for command

Examples:
  testsprite test run --all --project <id>                all test cases in the project, in wave order
  testsprite test run <id> <id> <id>                      several test cases in one run (any number of ids; sent 50 per request)
  testsprite test run <id> <id> --local 3000             several local test cases, one tunnel
  testsprite test run --all --status failed --env staging test cases whose latest status is failed, run in staging
  testsprite test run --all --filter <substr> --wait --report junit --report-file ./results.xml

On the legacy backend-only engine, FE test cases are skipped (reported under skippedFrontend);
run them with \`test run <id>\`. BE test cases can declare --produces/--needs at create time to order waves.

Queueing and limits:
  - Each request starts one run; its results show queued until they start,
    as in the Portal.
  - A test case that already has a run in flight is a conflict (exit 6), not queued.
  - Run triggers are limited to 60 per minute per API key; that limit clears on
    its own and is retried for you. An older backend may still answer with
    deferred ids: they are reported, not resent, and exit 7.
  - --max-concurrency here bounds the --wait poll fan-out, not dispatch.

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > test steps 1`] = `
"Usage: testsprite test steps [options] <test-id>

List the steps of the latest run (use --run-id for a specific run)

Options:
  --page-size <n>           fetch ONE page of N steps (1-100) and print the
                            next token (default: follow every page); ignored
                            with --run-id
  --max-items <n>           stop after this many items across auto-paged pages;
                            ignored with --run-id
  --starting-token <token>  opaque cursor from a previous response; ignored
                            with --run-id
  --run-id <id>             Show steps of the specified run instead of the
                            latest run.
  -h, --help                display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > testlist 1`] = `
"Usage: testsprite testlist [options] [command]

Manage test lists (groups of tests)

Options:
  -h, --help                               display help for command

Commands:
  list [options]                           List test lists visible to the API key
  get <list-id>                            Get a test list with its cases
  create [options]                         Create a test list
  update [options] <list-id>               Update a test list (name and/or environments)
  delete [options] <list-id>               Delete a test list and its schedules (requires --confirm)
  add [options] <list-id> <test-id...>     Add one or more tests to a test list
  remove [options] <list-id> <test-id...>  Remove one or more tests from a test list
  run [options] <list-id>                  Run a test list
  help [command]                           display help for command
"
`;

exports[`--help snapshots > testlist add 1`] = `
"Usage: testsprite testlist add [options] <list-id> <test-id...>

Add one or more tests to a test list

Options:
  --idempotency-key <key>  caller-supplied idempotency key (1-256 chars)
  -h, --help               display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > testlist create 1`] = `
