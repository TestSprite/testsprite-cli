exports[`--help snapshots > project list 1`] = `
"Usage: testsprite project list [options]

List projects visible to the API key

Exit codes:
  0  success
  3  auth error
  5  validation error (e.g., bad --page-size)
 10  transport/network failure (UNAVAILABLE) — retry the command

Options:
  --page-size <n>           page size (1-100, default 25); alone it returns one
                            page plus a next --starting-token (add --max-items
                            to auto-page)
  --starting-token <token>  opaque cursor from a previous list response
  --max-items <n>           stop after this many items across auto-paged pages
  --columns <list>          select/reorder text table columns (comma-separated
                            keys: id, name, type, from, org, url, created,
                            defaultenv, envs)
  --no-header               suppress the text table header row
  -h, --help                display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > project update 1`] = `
"Usage: testsprite project update [options] <project-id>

Update a project's name, extra instructions or test-id attributes

Options:
  --name <name>                new project name
  --instruction <text>         replace the current instructions (read them with
                               project get)
  --test-id-attributes <list>  comma-separated DOM attributes the engine should
                               prefer as locators, highest priority first (e.g.
                               data-element,data-testid); replaces the current
                               list
  --clear-test-id-attributes   remove the test-id attribute list (engine falls
                               back to data-testid) (default: false)
  --idempotency-key <token>    opaque idempotency token. Defaults to a UUIDv4
                               minted per invocation.
  -h, --help                   display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > reject 1`] = `
"Usage: testsprite reject [options] [reason...]

Arguments:
  reason               what to change

Options:
  --card <id>          the card to decide, by the id the conversation showed
                       (default: the one last shown in this folder); one
                       decided meanwhile is refused
  --project <id>       project id (default: TESTSPRITE_PROJECT_ID, else the one
                       last used in this folder)
  --conversation <id>  conversation id (default: the one last started from this
                       folder)
  --no-wait            return as soon as the agent has it, without following it
  --timeout <seconds>  stop following after this long (default: no limit in a
                       terminal, 540s otherwise); the agent keeps working
  --steps              show each proposed test step by step
  -h, --help           display help for command

Example:
  testsprite reject "split the coupon test: one for the limit, one for expired codes"

Exit codes:
  0   the agent proposed something or replied
  1   the agent stopped before it finished, or the conversation ended
  5   invalid input (no project, a missing file, --diff outside a repository)
  6   the conversation is not waiting for this (e.g. apply with nothing proposed)
  7   still working at --timeout; follow it with \`testsprite status --wait\`
  13  the agent is not enabled for this account

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > reply 1`] = `
"Usage: testsprite reply [options] <message...>

Arguments:
  message              what to tell the agent

Options:
  --diff [base]        attach your change since <base>
  --file <path>        attach a document (repeatable)
  --project <id>       project id (default: TESTSPRITE_PROJECT_ID, else the one
                       last used in this folder)
  --conversation <id>  conversation id (default: the one last started from this
                       folder)
  --no-wait            return as soon as the agent has it, without following it
  --timeout <seconds>  stop following after this long (default: no limit in a
                       terminal, 540s otherwise); the agent keeps working
  --steps              show each proposed test step by step
  -h, --help           display help for command

Examples:
  testsprite reply "use the qa-admin account for the admin pages"
  testsprite reply "the last run failed; which failures are real bugs?"

Exit codes:
  0   the agent proposed something or replied
  1   the agent stopped before it finished, or the conversation ended
  5   invalid input (no project, a missing file, --diff outside a repository)
  6   the conversation is not waiting for this (e.g. apply with nothing proposed)
  7   still working at --timeout; follow it with \`testsprite status --wait\`
  13  the agent is not enabled for this account

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > result 1`] = `
"Usage: testsprite result [options] [command]

List and read test results

Options:
  -h, --help                 display help for command

Commands:
  list [options]             List the results of a run or of a test
  get [options] <result-id>  Read one result: verdict, cause, failed step
  help [command]             display help for command
"
`;

exports[`--help snapshots > result get 1`] = `
"Usage: testsprite result get [options] <result-id>

Read one result: its verdict, error, cause and fix, the failed step's screenshot and
the video. A result is one test's part of a run, printed as resultId. Every step is
in --output json.

With --out <dir>, download it instead: result.json (the result, each link replaced
by the file it was written to), the video, and each step's screenshot and page as
steps/001.png, steps/001.html, ...; a result blocked at sign-in adds the sign-in
run's video and steps under sign-in/. <dir> is created if missing. In an existing
<dir>, result.json, video.<mp4|webm|mov|mkv|avi>, steps/ and sign-in/ are replaced
once the download ends, and every other file is left alone; a file that fails keeps
the copy an earlier download of the same result left.

Exit codes:
   0  read, whatever the verdict (with --out: every file written)
   3  auth error
   4  result not found
   5  validation error
  10  with --out: a file could not be downloaded; the others and result.json are written

Options:
  --out <dir>    write the result and its evidence (video, each step's files)
                 into <dir>
  --failed-only  with --out: only the failed steps and one step on each side
                 (every step when none failed)
  -h, --help     display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > result list 1`] = `
"Usage: testsprite result list [options]

List the results of one run (--run <run-id>), or one test's results across runs,
newest first (--test <test-id>). A run id is the runId testsprite run prints;
a result is one test's part of a run, printed as resultId.

Read one result with: testsprite result get <result-id>

Exit codes:
  0  listed, whatever the verdicts
  3  auth error
  4  run or test not found
  5  validation error

Options:
  --run <run-id>    list the results of this run
  --test <test-id>  list this test's results, newest first
  --status <list>   keep only these statuses: passed, failed, running, blocked,
                    cancelled (comma-separated or repeated, any case). Running
                    includes queued results. Cancelled results are listed only
                    when named
  --env <name>      with --test: only results from this project environment
  --limit <n>       with --test: how many results (1-100, default 20)
  -h, --help        display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > run 1`] = `
"Usage: testsprite run [options] [command] [test-id...]

Run a whole project, named test cases or a saved list (--testlist <id>). Saved loopback environments open a tunnel automatically and wait for a verdict.
Pass several <test-id>s, or use --project <id> [--filter <substr>], for a batch run (IDs are grouped per project into one request (at most 5000 named IDs per project)). Loopback environments share one tunnel.

Exit codes:
  0  passed (or queued without --wait)
  1  failed / blocked / cancelled
  3  auth error
  4  test not found
  5  validation error (e.g., bad URL, or conflicting selectors)
  6  conflict (already running — see nextAction for the active runId and resultId)
  7  timeout — resume with: testsprite run wait <run-id>, or stop it with: testsprite run cancel <run-id>
 10  transport/network failure (UNAVAILABLE). If it printed a runId with status
     running, that run is still executing: check it with testsprite run wait
     <run-id> (running this command again triggers and bills a new run).
     With --local or a local environment, the tunnel closed with this command
     and run wait cannot reopen it: follow the printed next step. If its
     cancellation was skipped, the run can still finish, but steps that need
     your machine can fail. Otherwise retry the command
 11  rate limited — honor Retry-After
 12  insufficient credits (non-retriable; top up)
 13  feature gated / workspace paused

JSON lists executions in runs and per-test outcomes in results. With --wait, summary counts the outcomes.
An incomplete timeout or interrupt adds partial: true.

On failure/blocked/cancelled, read the result: testsprite result get <result-id>
(add --out <dir> to download its evidence). <run-id> is the execution, printed as runId;
<result-id> is one test's part of it, printed as resultId.

Ctrl-C during an ordinary --wait detaches; an owned tunnel cancels unfinished runs by default.
Stop a detached run with: testsprite run cancel <run-id>
Dev servers can take a minute per page through a tunnel; prefer a built server (npm run build, then start).

Options:
  --target-url <url>          frontend tests only: run against this URL, using
                              the environment for its origin (else a temporary
                              one deleted after the run); with --env, that
                              environment's settings; loopback URLs open a
                              tunnel
  --skip-preflight            skip the pre-charge reachability probe of the
                              target URL (it runs from this machine, not the
                              cloud, so it can be wrong, e.g. behind an IP
                              allowlist) (default: false)
  --local <port>              run against an app on THIS machine through a
                              TestSprite tunnel (the runner opens
                              http://localhost:<port>). Implies --wait.
                              Frontend tests only; several ids or --project
                              start one run per project through one tunnel (see
                              --max-concurrency). A dead port is refused before
                              anything is billed.
  --local-host <host>         with --local, loopback address in the target URL:
                              localhost, 127.0.0.1, ::1 (default: saved
                              matching host, else localhost). Use localhost if
                              your app only answers on that name, ::1 for
                              IPv6-only.
  --tunnel-client <id>        for a loopback environment or --local, attach to
                              a tunnel already running under \`testsprite tunnel
                              start\` (use the id it prints) instead of opening
                              one; that process keeps the tunnel open
                              afterwards.
  --no-cancel-on-interrupt    with a tunnel, do not auto-cancel runs when an
                              owned tunnel closes or a borrowed tunnel's owner
                              disappears
  --env <name>                run against the named project environment — its
                              credentials, auto-auth and OTP settings (see
                              \`testsprite project env list <project-id>\`); a
                              loopback one opens a tunnel. Default: the
                              project's default environment. Also applies to
                              whole-project runs.
  --wait                      poll until terminal status or --timeout elapses
                              (default: false)
  --no-wait                   detach without opening an automatic environment
                              tunnel
  --timeout <s>               with --wait, one shared deadline for all
                              executions (1–3600 seconds; default 600, or 1200
                              through a tunnel)
  --idempotency-key <key>     opaque key for safe retries (1–256 chars);
                              unchanged for one project, with stable
                              project-specific suffixes for several projects
  --project <id>              run the whole project (overrides
                              TESTSPRITE_PROJECT_ID); excludes named test IDs
                              and --testlist
  --testlist <id>             run a saved list; optional positional IDs select
                              its cases using saved project/environment
                              mappings
  --filter <substr>           with a project run: only run tests whose name
                              contains this non-empty substring
                              (case-insensitive); omit to run every test
  --max-concurrency <n>       project/multiple IDs server limit; with a tunnel:
                              1-15, default 5; without a tunnel: 1-100, default
                              50; single-test adapter default 5; saved lists:
                              1-50/default 10, or tunnel 1-10/default 5
  --report <format>           with a --wait batch (project, several IDs or
                              saved list): write a JUnit XML sidecar report
                              after polling (accepted: junit)
  --report-file <path>        output path for --report (atomic write)
  --report-suite-name <name>  optional JUnit suite name (default:
                              testsprite:<projectId>, or
                              testsprite:testlist:<listId>)
  --gh-output                 with --wait: emit GitHub annotations (::error::
                              failed/timed-out, ::warning:: never dispatched)
                              and a job-summary table when $GITHUB_STEP_SUMMARY
                              is set; auto-enabled when GITHUB_ACTIONS=true
  --summary-file <path>       with --wait: also write summary JSON {total,
                              passed, failed, blocked?, cancelled?, errors?,
                              skipped, timedOut, results[]} to this file
  --allow-empty               with a project or multi-ID batch: exit 0 when
                              ZERO test cases are dispatched (default: exit 5,
                              so an empty run is not a CI false-green)
  --skip-dependencies         Backend test cases only: run without the test
                              cases they depend on (default: false)
  -h, --help                  display help for command

Commands:
  wait [options] <run-id...>  Wait for one or more whole executions to finish
  cancel <run-id...>          Cancel every queued/running test in one or more
                              runs (the server reports per-result cancellation
                              and refund outcomes)
  help [command]              display help for command

Examples:
  testsprite run --project <id>                all test cases in the project, in wave order
  testsprite run <id> <id> <id>                      several test cases in one run (one request per project; at most 5000 named IDs per project)
  testsprite run <id> <id> --local 3000             several local test cases, one tunnel
  testsprite run --project <id> --env staging                all test cases in the project, run in staging
  testsprite run --project <id> --filter <substr> --wait --report junit --report-file ./results.xml
  testsprite run --testlist <list-id> --wait             all saved list cases, using pinned environments
  testsprite run <id> <id> --testlist <list-id> --wait   selected saved list cases
  testsprite run wait <run-id...> --timeout 600         resume without starting a new run
  testsprite run cancel <run-id...>                    cancel whole executions

List mode: concurrency defaults to 10 (1-50), or 5 through a tunnel (1-10); timeout defaults to 600 even through a tunnel.
List environments come from saved project mappings; --env, --target-url, --local and other project-only launch flags are refused.

Queueing and limits:
  - Each request starts one run; its results show queued until they start,
    as in the Portal.
  - In-flight test cases appear as held references; --wait verifies compatibility
    before joining only those results. Other cases remain skipped or conflict.
  - Server rate limits retain their error details and Retry-After policy.
  - --max-concurrency is a server limit per execution, never a shared client budget.

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > run cancel 1`] = `
"Usage: testsprite run cancel [options] <run-id...>

Cancel one or more whole executions, including queued work and later integration phases.

A run id is the runId \`run\` prints, not an individual resultId.
The CLI sends one cancellation request per execution, without listing results first.
The server owns membership and terminal races; already-finished or already-cancelled
executions return their current state. Each response includes native result IDs
and refund outcomes. A failed refund can be retried with the same run ID.

Ctrl-C during an ordinary --wait only detaches; use this command to stop the run.
Owned-tunnel runs are cancelled on interrupt by default; see \`run --help\`.

Exit codes:
  0  executions cancelled, already cancelled or already finished
  1  a local cancellation failure
  3  authentication or permission failure
  4  an execution ID was not found (other requested cancellations may have succeeded)
 10  server or transport unavailable
 11  rate limited after automatic retries
 14  client too old
Other server errors retain their original exit classification.

Output: {runs, cancelled, alreadyCancelled, alreadyFinished, notFound, errors}.
Each run includes result outcomes; notFound and errors identify executions.

Arguments:
  run-id      one or more execution IDs (the runId \`run\` prints)

Options:
  -h, --help  display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > run wait 1`] = `
"Usage: testsprite run wait [options] <run-id...>

Wait for authoritative execution status, including later integration results.

A run id is the runId \`run\` prints, not an individual resultId.
Each read lists GET /results?run=<run-id>; no individual result cards are polled.
Each distinct run is read independently; runs share one --timeout deadline. Finished rows alone do not finish an execution.
A cancelled execution fails even when its existing results all passed or are empty.

JSON contains top-level runs, results and summary. An incomplete wait reports partial: true on timeout or interrupt.

Exit codes:
  0  executions finished without failed, blocked or cancelled results
  1  a result failed/blocked/cancelled, or an execution was cancelled
  3  authentication or permission failure
  4  an execution ID was not found
  7  deadline expired, or the backend lacks whole-run status
 10  server or transport unavailable through the deadline
 11  standing rate limit (a transient throttle exhausting --timeout reports 7)
 14  client too old

Inspect details with: testsprite result get <result-id> (add --out <dir> for evidence).
Ctrl-C detaches; executions continue. Resume with: testsprite run wait <run-id...>
Stop them with: testsprite run cancel <run-id...>

Options:
  --timeout <s>  shared seconds to wait for executions (1–3600, default 600)
  -h, --help     display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

