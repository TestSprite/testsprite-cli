exports[`--help snapshots > test 1`] = `
"Usage: testsprite test [options] [command]

Create, run and inspect tests

Options:
  -h, --help                            display help for command

Commands:
  list [options]                        List tests in a project
  get <test-id>                         Get a test by id
  create [options]                      Create a test from code (--code-file)
                                        or a plan (--plan-from)
  create-batch [options]                Create multiple FE tests from JSONL
                                        plan specs
  scaffold [options]                    Emit a starter FE plan or BE skeleton
                                        (local)
  open [options] <test-id>              Open the test in the TestSprite
                                        dashboard (prints the URL, then opens
                                        your browser)
  steps [options] <test-id>             List the steps of the latest run (use
                                        --run-id for a specific run)
  diff <run-a> <run-b>                  Compare two runs; exit 1 if their
                                        verdicts differ
  lint [options]                        Validate plan/steps files offline
  result [options] <test-id>            Get the latest result, or list prior
                                        runs (--history)
  update [options] <test-id>            Update name, description, priority or
                                        step timeout
  delete [options] <test-id>            Permanently delete a test (requires
                                        --confirm)
  delete-batch [options] [test-ids...]  Permanently delete several tests
                                        (requires --confirm)
  run [options] [test-id...]            Run a test, or a whole project (--all)
  wait [options] <run-id...>            Wait for one or more runs to finish
  code                                  Inspect and edit generated test code
  plan                                  Generate + accept AI test plans (V3),
                                        and manage FE plan-steps
  failure                               Export the latest-failure agent bundle
  artifact                              Download run-scoped artifact bundles
  cancel <run-id...>                    Cancel queued/running runs (refunds an
                                        unfinished FE V3 run)
  help [command]                        display help for command
"
`;

exports[`--help snapshots > test cancel 1`] = `
"Usage: testsprite test cancel [options] <run-id...>

Cancel one or more queued/running runs.

Ctrl-C during an ordinary --wait only detaches; it does NOT cancel the run (owned-tunnel
runs are cancelled on interrupt, see \`test run --help\`). This is the real stop button.
A frontend V3 run cancelled before a terminal state has its charge returned; backend and
V2 runs keep their billing, and an in-flight Lambda finishes with its result discarded.

Exit codes:
  0  cancelled (fresh or already-cancelled — naturally idempotent)
  1  multi-id: a cancel request failed (auth/transport/server error; see summary.errors)
  4  run id not found (single id), or ANY id not found (multi-id; outranks conflict)
  6  run already terminal (passed/failed/blocked); multi-id: any conflict

Multi-id output is a summary: {cancelled, alreadyCancelled, conflicts, notFound, errors}.

Arguments:
  run-id      one or more run ids to cancel

Options:
  -h, --help  display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > test code get 1`] = `
"Usage: testsprite test code get [options] <test-id>

Print the generated test code

Options:
  --out <path>  Write the response to this file instead of stdout (text mode:
                source body; json mode: wire envelope)
  -h, --help    display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > test create 1`] = `
"Usage: testsprite test create [options]

Create a test from saved code (--code-file) or an agent-supplied plan
(--plan-from, FE-only)

Options:
  --project <id>             project id (see \`testsprite project list\`)
  --type <type>              frontend|backend
  --name <name>              human-readable test name
  --description <text>       optional human description (≤ 2000 chars)
  --priority <prio>          optional priority: p0/high, p1/medium, p2/low (p3
                             = low)
  --step-timeout <ms>        per-test step timeout in milliseconds (1-60000)
  --code-file <path>         file containing the test code (≤ 350 KB)
  --plan-from <path>         JSON file with the full FE test definition (≤ 256
                             KB; excludes --code-file);
                             --project/--type/--name/--description/--priority/--step-timeout
                             are ignored
  --plan-template            print a plan-file skeleton to stdout and exit
                             (local; ignores every other flag) (default: false)
  --run                      after create, trigger the test (default: false)
  --wait                     with --run, poll until terminal status (default:
                             false)
  --no-wait                  with --run, detach: no waiting and no automatic
                             tunnel (a loopback target is unreachable from the
                             cloud)
  --timeout <s>              with --run --wait, max seconds to wait (1-3600;
                             default 600, or 1200 through a tunnel)
  --target-url <url>         frontend tests only: run against this URL, using
                             the environment for its origin (else a temporary
                             one deleted after the run); with --env, that
                             environment's settings; loopback URLs open a
                             tunnel
  --env <name>               with --run, select the named project environment;
                             loopback URLs open a tunnel automatically
  --skip-preflight           skip the pre-charge reachability probe of the
                             target URL (it runs from this machine, not the
                             cloud, so it can be wrong, e.g. behind an IP
                             allowlist) (default: false)
  --idempotency-key <token>  idempotency token (1-256 ASCII chars; default:
                             random UUID per invocation, pin one for safe
                             retries)
  --produces <var>           BE only: variable this test captures (repeatable);
                             orders waves in \`test run --all\` (default: [])
  --needs <var>              BE only: variable this test consumes (repeatable);
                             declares the upstream producer (default: [])
  --category <str>           BE only: test category; 'teardown' or 'cleanup'
                             marks a final-wave cleanup test (BE-only flags
                             with --type frontend exit 5)
  -h, --help                 display help for command

Plan file format (--plan-from <file>) — minimal valid example:

{
  "$schema": "https://raw.githubusercontent.com/TestSprite/testsprite-cli/v0.16.0/schemas/plan.schema.json",
  "projectId": "prj_abc123",
  "type": "frontend",
  "name": "Login rejects an empty password",
  "planSteps": [
    {
      "type": "action",
      "description": "Navigate to /login and submit the form with an empty password"
    },
    {
      "type": "assertion",
      "description": "Verify an inline error says the password is required"
    }
  ]
}

Validate offline:  testsprite test create --plan-from <file> --dry-run
Many tests:        testsprite test create-batch --plans <file.jsonl>


Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > test create-batch 1`] = `
"Usage: testsprite test create-batch [options]

Create multiple FE tests from a JSONL of plan specs (FE-only).
Each JSONL line (or --plan-from-dir file) is a \`test create --plan-from\` plan;
see \`test scaffold\`.

Options:
  --plans <path>             JSONL file with one plan-from spec per line (≤ 50
                             specs, ≤ 5 MB)
  --plan-from-dir <dir>      directory of *.json plan files — each file is one
                             plan spec (≤ 50 files, ≤ 5 MB total). Sorted by
                             filename for determinism. Mutually exclusive with
                             --plans.
  --run                      after create, trigger each created test as a run
                             (default: false)
  --max-concurrency <n>      with --run: max in-flight triggers (1-100, default
                             50; through a tunnel 1-10, default 5). Triggers
                             are throttled to 50/min (server cap 60/min/key)
                             and retried on rate limits. With --wait a slot is
                             held until each run finishes; without --wait this
                             only paces dispatch. Runs beyond what the account
                             executes at once queue on the server.
  --wait                     with --run, poll each run until terminal status
                             (default: false)
  --no-wait                  detach without opening an automatic environment
                             tunnel
  --timeout <s>              with --run --wait, per-run max seconds to wait
                             (1-3600, default 600)
  --target-url <url>         with --run: frontend tests only: run against this
                             URL, using the environment for its origin (else a
                             temporary one deleted after the run); with --env,
                             that environment's settings; loopback URLs open a
                             tunnel
  --env <name>               with --run, run each test in the named project
                             environment; loopback URLs open a tunnel
  --skip-preflight           with --run: skip the pre-charge reachability probe
                             of the target URL (it runs from this machine, not
                             the cloud, so it can be wrong, e.g. behind an IP
                             allowlist) (default: false)
  --idempotency-key <token>  idempotency token for the batch (1-256 ASCII
                             chars; default: random UUID, pin one for safe
                             retries)
  -h, --help                 display help for command

Example:
  testsprite test create-batch --plans plans.jsonl --run --wait

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > test failure get 1`] = `
"Usage: testsprite test failure get [options] <test-id>

Write the failure bundle for a test's latest failing run (same layout as \`test artifact get\`).

Exit codes:
  0  success
  3  authentication error
  4  test not found, or it has no failing run
  5  validation error (bad --out)
 10  transport failure

Options:
  --out <dir>    directory to write the bundle into (default: print the
                 envelope to stdout)
  --failed-only  with --out: trim to the failed step ±1 (usually a no-op; \`test
                 steps <id>\` has the full trail)
  -h, --help     display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > test flaky 1`] = `
"Usage: testsprite test flaky [options] <test-id>

[deprecated] No replacement; run \`testsprite test run <test-id>\` again to sample a test case; removed in 0.17.0.
Repeatedly replay a test case to measure stability.
Replays run with auto-heal OFF (strict verbatim) so healing cannot mask a flaky pass/fail.

Exit codes:
  0  stable (every attempt passed)
  1  flaky or failing (at least one attempt did not pass)
  3  auth error
  4  test not found (no replayable run — trigger \`testsprite test run <id>\` first)
  5  validation error

Options:
  --runs <n>     number of replays to run (1-10, default 5)
  --until-fail   stop at the first non-passing attempt (fast "is it flaky at
                 all?" check) (default: false)
  --timeout <s>  per-attempt max seconds to wait (1-3600, default 600)
  -h, --help     display help for command

Notes:
  • Each replay is billed as a rerun (0.5 credits per FE replay, 0.2 per BE replay), so
    \`--runs N\` costs about N×0.5 for a frontend test (legacy V2 accounts: FE rerun is free).
  • \`--output json\` emits a stability report for CI gating.

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

