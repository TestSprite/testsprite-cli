exports[`--help snapshots > testlist run 1`] = `
"Usage: testsprite testlist run [options] <list-id>

Run a test list (dispatch its cases and return pollable run ids). Environments come from the list's --project-env mapping; loopback ones open one tunnel and wait (backend cases are skipped).

Exit codes:
  0  dispatched (or all passed with --wait)
  1  a run failed / blocked / cancelled
  3  auth error
  4  a --case id is not in the list
  6  nothing dispatched: every case conflicted (already running, or cannot run here)
  7  timeout, or some cases were rate-deferred (retry the printed ids)
 12  insufficient credits (non-retriable; top up)
 13  feature gated / workspace paused

Options:
  --case <test-id>            run only this case (repeatable; default: every
                              case in the list) (default: [])
  --wait                      poll every dispatched run until terminal or
                              --timeout (default: false)
  --no-wait                   detach without opening an automatic environment
                              tunnel
  --skip-preflight            skip the loopback port probe before opening a
                              tunnel
  --timeout <s>               with --wait, max seconds to wait (1–3600, default
                              600)
  --max-concurrency <n>       with a tunnel, max runs in flight (1-10, default
                              5); otherwise with --wait, max polls (1-50,
                              default 10)
  --idempotency-key <key>     caller-supplied idempotency key (1-256 chars)
  --report <format>           with --wait: write a JUnit XML sidecar after
                              polling (accepted: junit)
  --report-file <path>        output path for --report (atomic write)
  --report-suite-name <name>  JUnit <testsuite name=...> override (default:
                              testsprite:testlist:<listId>)
  --gh-output                 with --wait: emit GitHub annotations (::error::
                              failed/timed-out, ::warning:: never dispatched)
                              and a job-summary table when $GITHUB_STEP_SUMMARY
                              is set; auto-enabled when GITHUB_ACTIONS=true
  --summary-file <path>       with --wait: also write summary JSON {total,
                              passed, failed, skipped, timedOut, runs[]} to
                              this file
  -h, --help                  display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > testlist update 1`] = `
"Usage: testsprite testlist update [options] <list-id>

Update a test list (name and/or environments)

Options:
  --name <name>                  new name
  --project-env <projectId:env>  replace the env mapping with these pairs
                                 (repeatable) (default: [])
  --clear-project-env            remove all environment mappings from the list
  --idempotency-key <key>        caller-supplied idempotency key (1-256 chars)
  -h, --help                     display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > top 1`] = `
"Usage: testsprite [options] [command]

Official TestSprite command-line interface

Options:
  -V, --version                output the version number
  --output <mode>              Output format (json|text) (default: "text")
  --profile <name>             Configuration profile to use
  --endpoint-url <url>         API base URL (a full http(s) URL)
  --verbose                    Log HTTP retry / backoff / polling transitions
                               to stderr (lighter than --debug)
  --debug                      Print HTTP method/path, request id, latency,
                               retry decisions to stderr
  --dry-run                    Skip the network and credentials; emit a canned
                               sample matching the OpenAPI contract. Exception:
                               run commands (\`test run\`, \`test rerun\`, \`test
                               create --run\`, \`testlist run\`) with credentials
                               and no explicit target may make read-only GETs
                               to preview an automatic tunnel target; nothing
                               is created or started. File inputs
                               (--plan-from/--plans/--steps) are still read
                               locally; --code-file uses a placeholder.
  --request-timeout <seconds>  Per-request timeout in seconds (default 120;
                               range 1–600, values outside are clamped). Does
                               not affect the --timeout polling ceiling for
                               \`test run/wait\`.
  -h, --help                   display help for command

Commands:
  setup [options]              Configure your API key and install the agent
                               skills
  auth                         Manage TestSprite credentials
  project                      Manage TestSprite projects
  test                         Create, run and inspect tests
  testlist                     Manage test lists (groups of tests)
  ci                           Run tests in CI and scaffold CI integration
  schedule                     Manage schedules (V3 workspace)
  tunnel                       Open a tunnel so TestSprite can reach an app on
                               this machine
  agent                        Install TestSprite guidance into coding-agent
                               config
  usage|credits                Show credit balance and plan info
  doctor                       Diagnose CLI setup: credentials, connectivity,
                               skill
  completion [shell]           Print a shell completion script (bash|zsh|fish)
  help [command]               display help for command

Environment:
  TESTSPRITE_API_KEY (overrides stored credentials), TESTSPRITE_NO_UPDATE_NOTIFIER (disables
  the version check); TESTSPRITE_API_URL, TESTSPRITE_PROFILE and TESTSPRITE_REQUEST_TIMEOUT_MS
  (milliseconds) mirror --endpoint-url, --profile and --request-timeout.
"
`;

exports[`--help snapshots > tunnel 1`] = `
"Usage: testsprite tunnel [options] [command]

Open a tunnel so TestSprite can reach an app on this machine

Options:
  -h, --help                  display help for command

Commands:
  start [options]             Open a tunnel and hold it until Ctrl-C
  list                        List live tunnel bindings for this account
  status <client-id>          Report whether a tunnel client is connected
  stop [options] [client-id]  Stop one tunnel, or all with --all
  help [command]              display help for command

Frontend runs open and close a tunnel automatically when the environment URL is on this
machine. Use these commands to share one tunnel across several runs or to check one a run
reported as down. A tunnel lives only as long as \`tunnel start\` runs: there is no background
daemon, because its credential is never written to disk.

Examples:
  testsprite tunnel start    # hold a tunnel open (Ctrl-C to stop)
  testsprite test run <test-id> --env <name> --tunnel-client <client-id>
  testsprite test run <test-id> --local 3000 --tunnel-client <client-id>
  testsprite tunnel stop --all --confirm

"
`;

exports[`--help snapshots > tunnel list 1`] = `
"Usage: testsprite tunnel list [options]

List live tunnel bindings for this account

Options:
  -h, --help  display help for command

Shows each tunnel client id, status, creation time and expiry, including tunnels opened automatically.

Exit codes:
  0  listed (possibly empty)
  3  auth error — the key needs the \`run:tunnel\` scope
  4  server too old to list tunnels
 10  could not reach TestSprite


Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > tunnel start 1`] = `
"Usage: testsprite tunnel start [options]

Open a tunnel and hold it until you stop the command (Ctrl-C)

Options:
  --ttl <seconds>  requested credential lifetime (60–28800), clamped by the
                   server; the credential is deleted on exit regardless, so
                   this only matters if the process is killed
  -h, --help       display help for command

Prints the client id to stderr as soon as it is minted; pass it to
\`test run <test-id> --env <name> --tunnel-client <client-id>\` for an environment on this machine.

Dev servers can take a minute per page through the tunnel; for a heavy one, test a built
server (\`npm run build\`, then your framework's preview/start command).

Exit codes:
  0  you stopped it (Ctrl-C is the normal way to end this command)
  3  auth error — the key needs the \`run:tunnel\` scope; mint a new key
 10  the tunnel service disconnected the client, or it never connected
 11  rate limited, or too many tunnels are already open for this account


Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > tunnel status 1`] = `
"Usage: testsprite tunnel status [options] <client-id>

Report whether a tunnel client of yours is connected

Options:
  -h, --help  display help for command

\`offline\` means the API answered and said nothing is connected with that id. A failure
to reach TestSprite is reported as its own error, never as \`offline\`.
Use the client id printed by a run that automatically opened a tunnel.

Exit codes:
  0  answered (the answer may be \`offline\`)
  4  no such tunnel for this account
  5  client id is not a UUID
 10  could not reach TestSprite to ask


Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

exports[`--help snapshots > tunnel stop 1`] = `
"Usage: testsprite tunnel stop [options] [client-id]

Destroy one tunnel credential or stop every live tunnel

Options:
  --all       stop every live tunnel on this account (default: false)
  --confirm   required with --all for this destructive operation (default:
              false)
  -h, --help  display help for command

Stopping one that is already gone succeeds. Revoking the credential
also makes a running \`tunnel start\` exit within ~15 s.
A run that automatically opened this tunnel loses access to its environment when you stop it.
Stopping all requires --confirm and also revokes tunnels used by other terminals and CI jobs;
--dry-run previews sample ids without it.

Exit codes:
  0  stopped (or already absent), including an empty --all result
  1  at least one tunnel could not be stopped
  3  auth error — the key needs the \`run:tunnel\` scope
  4  server too old to list tunnels (with --all)
  5  invalid arguments (e.g. a client id that is not a UUID) or --all without --confirm
 10  could not reach TestSprite


Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;
