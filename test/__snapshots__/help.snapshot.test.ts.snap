exports[`--help snapshots > testlist run 1`] = `
"Usage: testsprite testlist run [options] <list-id>

Run a test list (dispatch its cases and return pollable run ids). Loopback
environments open a tunnel automatically and wait.

Options:
  --case <test-id>            run only this case (repeatable; default: every
                              case in the list) (default: [])
  --wait                      poll every dispatched run until terminal or
                              --timeout (default: false)
  --no-wait                   detach without opening an automatic environment
                              tunnel
  --skip-preflight            skip the loopback port probe before opening a
                              tunnel
  --timeout <s>               with --wait, max seconds to wait (1–3600, default
                              600)
  --max-concurrency <n>       with a tunnel, max runs in flight (1-10, default
                              5); otherwise with --wait, max polls (1-50,
                              default 10)
  --idempotency-key <key>     caller-supplied idempotency key (1-256 chars)
  --report <format>           with --wait: write a JUnit XML sidecar after
                              polling (accepted: junit)
  --report-file <path>        output path for --report (atomic write)
  --report-suite-name <name>  JUnit <testsuite name=...> override (default:
                              testsprite:testlist:<listId>)
  --gh-output                 with --wait: emit GitHub-native output (::error::
                              annotations for failed/timed-out members,
                              ::warning:: for never-dispatched ones;
                              job-summary table when $GITHUB_STEP_SUMMARY is
                              set). Auto-enabled when GITHUB_ACTIONS=true
  --summary-file <path>       with --wait: also write the reduced machine
                              summary JSON {total, passed, failed, skipped,
                              timedOut, runs[]} to this file
  -h, --help                  display help for command

