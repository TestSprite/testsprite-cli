exports[`--help snapshots > project sign-in set 1`] = `
"Usage: testsprite project sign-in set [options] <project-id>

Set the sign-in mode. OTP can only be chosen at \`project env create --sign-in
otp\`, never switched to or from.
manual (log in once in the Portal; runs are not signed in until then) and otp
are not available on local environments.

Options:
  --mode <mode>                  required: public, account or manual (aliases:
                                 none, credentials, sso)
  --env <name>                   environment name (defaults to the project
                                 default)
  --username <user>              test-account username (account only)
  --password <pw>                test-account password (prefer --password-file,
                                 exclusive; account only)
  --password-file <path>         read the test-account password from a file
                                 (account only)
  --session-ttl <seconds|never>  SSO session reuse lifetime: 1–2592000 seconds
                                 or never (manual only)
  --idempotency-key <token>      opaque idempotency token. Defaults to a UUIDv4
                                 minted per invocation.
  -h, --help                     display help for command

Global options (--dry-run, --output, --profile, --endpoint-url, --request-timeout, --verbose, --debug):
  testsprite --help
"
`;

