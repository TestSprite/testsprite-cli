exports[`--help snapshots > testlist 1`] = `
"Usage: testsprite testlist [options] [command]

Manage test lists (groups of tests)

Options:
  -h, --help                               display help for command

Commands:
  list [options]                           List test lists visible to the API key
  get <list-id>                            Get a test list with its cases
  create [options]                         Create a test list
  update [options] <list-id>               Update a test list (name and/or environments)
  delete [options] <list-id>               Delete a test list and its schedules (requires --confirm)
  add [options] <list-id> <test-id...>     Add one or more tests to a test list
  remove [options] <list-id> <test-id...>  Remove one or more tests from a test list
  run [options] <list-id>                  Run a test list (dispatch its cases and return pollable run ids). Loopback environments open a tunnel automatically and wait.
  help [command]                           display help for command
"
`;

