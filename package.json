{
  "name": "@testsprite/testsprite-cli",
  "version": "0.5.0",
  "description": "Official TestSprite command-line interface",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "testsprite": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "schemas",
    "!dist/**/*.map"
  ],
  "scripts": {
    "generate:version": "node scripts/generate-version.mjs",
    "prebuild": "node scripts/generate-version.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "clean": "rm -rf dist coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && vitest run -c vitest.e2e.config.ts"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TestSprite/testsprite-cli.git"
  },
  "bugs": {
    "url": "https://github.com/TestSprite/testsprite-cli/issues"
  },
  "keywords": [
    "testsprite",
    "cli",
    "testing",
    "automation",
    "test-automation",
    "ai-testing",
    "e2e",
    "qa",
    "api-testing",
    "playwright",
    "mcp",
    "claude-code",
    "agent"
  ],
  "author": "TestSprite team",
  "license": "Apache-2.0",
  "dependencies": {
    "commander": "^12.1.0",
    "undici": "^7.16.0",
    "valibot": "^1.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.4",
    "ajv": "^8.20.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.7.0",
    "msw": "^2.14.3",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  }
}
